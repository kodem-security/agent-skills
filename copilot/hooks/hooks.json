{
  "version": 1,
  "hooks": {
    "userPromptSubmitted": [
      {
        "type": "command",
        "bash": "kodem-cli agent hook start --platform copilot",
        "powershell": "kodem-cli agent hook start --platform copilot",
        "timeoutSec": 120
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "kodem-cli agent hook stop --platform copilot",
        "powershell": "kodem-cli agent hook stop --platform copilot",
        "timeoutSec": 600
      }
    ]
  }
}
