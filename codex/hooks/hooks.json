{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "kodem-cli agent hook start --platform codex",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "kodem-cli agent hook stop --platform codex",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
