{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/hooks/capture-baseline.sh\" --platform cursor",
        "timeout": 120
      }
    ],
    "stop": [
      {
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/hooks/end-of-turn-review.sh\" --platform cursor",
        "timeout": 600,
        "loop_limit": 3
      }
    ]
  }
}
