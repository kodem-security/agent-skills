{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "kodem-cli agent hook start --platform cursor || echo '{\"continue\":true}'",
        "timeout": 120
      }
    ],
    "stop": [
      {
        "command": "kodem-cli agent hook stop --platform cursor",
        "timeout": 600,
        "loop_limit": 3
      }
    ]
  }
}
