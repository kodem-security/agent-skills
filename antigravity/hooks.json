{
  "hooks": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "kodem-cli agent hook start --platform antigravity",
        "timeout": 120
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "kodem-cli agent hook stop --platform antigravity",
        "timeout": 600
      }
    ]
  }
}
